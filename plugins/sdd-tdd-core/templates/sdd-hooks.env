# Copiar a .claude/sdd-hooks.env del proyecto y versionarlo. Es la configuracion que
# manda para este repo; el userConfig del plugin solo actua como fallback cuando una
# clave queda vacia aqui.
# Regex extendida (grep -E) que identifica un comando como dirigido a producción:
# refs de base de datos, nombres de app de prod, dominios. Vacío = solo patrones genéricos.
SDD_PROD_MARKERS=
# Rama base del proyecto (develop | main).
SDD_BASE_BRANCH=develop
# Nombre del campo de tenant en DTOs/esquema (vacío si el proyecto es single-tenant).
SDD_TENANT_FIELD=
# Regex (grep -E) que reconoce una corrida de tests para la evidencia TDD.
# Vacío = default multi-stack (vitest, jest, tsc, phpunit, pest, artisan test, pytest, go test, cargo test, dotnet test, mvn/gradle test).
SDD_TEST_CMD_RE=
# Comentarios en codigo: bloque contiguo maximo (lineas) y porcentaje maximo de lineas comentadas por archivo.
# Vacio = defaults del plugin (4 y 15). Tests, migraciones, *.config.* y scripts/ quedan exentos.
SDD_COMMENT_MAX_BLOCK=
SDD_COMMENT_MAX_PCT=
