{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "enableAllProjectMcpServers": false,
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(go list:*)",
      "Bash(go env:*)",
      "Bash(go version:*)",
      "Bash(go doc:*)",
      "Bash(go mod download:*)",
      "Bash(go mod tidy -diff:*)",
      "Bash(go mod why:*)",
      "Bash(go mod graph:*)",
      "Bash(go tool -modfile=tools/go.mod golangci-lint run:*)",
      "Bash(go tool -modfile=tools/go.mod govulncheck:*)",
      "Bash(go tool -modfile=tools/go.mod sqlc generate:*)",
      "Bash(go tool -modfile=tools/go.mod sqlc vet:*)",
      "Bash(go tool -modfile=tools/go.mod oapi-codegen:*)",
      "Bash(go tool cover:*)",
      "Bash(go run ./cmd/migrate -schema:*)",
      "Bash(gofmt -l:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git config --local:*)",
      "Bash(git add:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git restore --staged:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up -d:*)",
      "Bash(docker compose logs:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(gh pr create:*)",
      "Bash(go get:*)",
      "Bash(go mod tidy:*)",
      "Bash(go mod edit:*)",
      "Bash(go install:*)",
      "Bash(go run ./cmd/migrate:*)",
      "Bash(gofmt -w:*)",
      "Bash(docker compose down:*)",
      "Bash(docker exec:*)",
      "Bash(psql:*)",
      "Bash(aws:*)",
      "Bash(cdk:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)"
    ],
    "deny": [
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(go get -u:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh pr merge:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Write(./**/.env)",
      "Write(./**/.env.*)"
    ]
  }
}
