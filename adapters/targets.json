{
  "claude": {
    "label": "Claude Code",
    "out": "plugins",
    "adapter": "claude.mjs",
    "vars": {
      "AGENT_NAME": "Claude Code",
      "CONTEXT_DOC": "CLAUDE.md",
      "AGENT_DIR": ".claude",
      "SKILLS_DIR": ".claude/skills",
      "SETTINGS_FILE": ".claude/settings.json",
      "PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
      "CMD_PREFIX": "/sdd-tdd-core:",
      "CONFIG_FILE": ".agentic/sdd-hooks.env",
      "LOCAL_STORE": ".agentic/sdd",
      "ATTRIBUTION_OFF": "el repo fija `\"includeCoAuthoredBy\": false` en `.claude/settings.json`"
    }
  },
  "codex": {
    "label": "Codex CLI",
    "out": "dist/codex",
    "adapter": "codex.mjs",
    "vars": {
      "AGENT_NAME": "Codex CLI",
      "CONTEXT_DOC": "AGENTS.md",
      "AGENT_DIR": ".codex",
      "SKILLS_DIR": ".agents/skills",
      "SETTINGS_FILE": ".codex/config.toml",
      "PLUGIN_ROOT": ".codex/sdd-tdd-core",
      "CMD_PREFIX": "/prompts:",
      "CONFIG_FILE": ".agentic/sdd-hooks.env",
      "LOCAL_STORE": ".agentic/sdd",
      "ATTRIBUTION_OFF": "Codex no agrega trailers por defecto; el grep post-commit de §3 es igualmente obligatorio"
    }
  },
  "opencode": {
    "label": "OpenCode",
    "out": "dist/opencode",
    "adapter": "opencode.mjs",
    "vars": {
      "AGENT_NAME": "OpenCode",
      "CONTEXT_DOC": "AGENTS.md",
      "AGENT_DIR": ".opencode",
      "SKILLS_DIR": ".opencode/skills",
      "SETTINGS_FILE": "opencode.json",
      "PLUGIN_ROOT": ".opencode/sdd-tdd-core",
      "CMD_PREFIX": "/",
      "CONFIG_FILE": ".agentic/sdd-hooks.env",
      "LOCAL_STORE": ".agentic/sdd",
      "ATTRIBUTION_OFF": "OpenCode no agrega trailers por defecto; el grep post-commit de §3 es igualmente obligatorio"
    },
    "models": {
      "opus": "anthropic/claude-opus-5",
      "sonnet": "anthropic/claude-sonnet-5",
      "haiku": "anthropic/claude-haiku-4-5-20251001"
    }
  },
  "devin": {
    "label": "Devin",
    "out": "dist/devin",
    "adapter": "devin.mjs",
    "vars": {
      "AGENT_NAME": "Devin",
      "CONTEXT_DOC": "AGENTS.md",
      "AGENT_DIR": ".agents",
      "SKILLS_DIR": ".agents/skills",
      "SETTINGS_FILE": "AGENTS.md",
      "PLUGIN_ROOT": ".agents/sdd-tdd-core",
      "CMD_PREFIX": "playbook ",
      "CONFIG_FILE": ".agentic/sdd-hooks.env",
      "LOCAL_STORE": ".agentic/sdd",
      "ATTRIBUTION_OFF": "Devin no agrega trailers por defecto; el grep post-commit de §3 es igualmente obligatorio"
    }
  }
}
